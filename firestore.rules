rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile Validation
    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'email'])
        && data.userId is string && data.userId.size() <= 128
        && data.email is string && data.email.size() <= 200
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500));
    }

    // Creation Validation
    function isValidCreation(data) {
      return data.keys().hasAll(['id', 'userId', 'type', 'title'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.type is string && data.type in ['video', 'image', 'music', 'transcription', 'chat_export']
        && data.title is string && data.title.size() <= 200
        && (!('prompt' in data) || (data.prompt is string && data.prompt.size() <= 2000))
        && (!('mediaUrl' in data) || (data.mediaUrl is string && data.mediaUrl.size() <= 500000))
        && (!('aspectRatio' in data) || (data.aspectRatio is string && data.aspectRatio.size() <= 20))
        && (!('model' in data) || (data.model is string && data.model.size() <= 100))
        && (!('metadata' in data) || (data.metadata is string && data.metadata.size() <= 5000));
    }

    // ChatSession Validation
    function isValidChatSession(data) {
      return data.keys().hasAll(['id', 'userId', 'title'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.title is string && data.title.size() <= 200
        && (!('model' in data) || (data.model is string && data.model.size() <= 100))
        && (!('systemInstruction' in data) || (data.systemInstruction is string && data.systemInstruction.size() <= 2000))
        && (!('messagesJson' in data) || (data.messagesJson is string && data.messagesJson.size() <= 500000));
    }

    // Users collection
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
        && request.auth.uid == userId 
        && isValidId(userId)
        && incoming().userId == request.auth.uid
        && isValidUserProfile(incoming());
      allow update: if isSignedIn() 
        && request.auth.uid == userId 
        && isValidId(userId)
        && existing().userId == request.auth.uid
        && incoming().userId == request.auth.uid
        && isValidUserProfile(incoming());
      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
    }

    // Creations collection
    match /creations/{creationId} {
      allow get: if isSignedIn() && isValidId(creationId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
        && isValidId(creationId)
        && incoming().userId == request.auth.uid
        && isValidCreation(incoming());
      allow update: if isSignedIn() 
        && isValidId(creationId)
        && existing().userId == request.auth.uid
        && incoming().userId == request.auth.uid
        && isValidCreation(incoming());
      allow delete: if isSignedIn() && isValidId(creationId) && resource.data.userId == request.auth.uid;
    }

    // Chats collection
    match /chats/{chatId} {
      allow get: if isSignedIn() && isValidId(chatId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
        && isValidId(chatId)
        && incoming().userId == request.auth.uid
        && isValidChatSession(incoming());
      allow update: if isSignedIn() 
        && isValidId(chatId)
        && existing().userId == request.auth.uid
        && incoming().userId == request.auth.uid
        && isValidChatSession(incoming());
      allow delete: if isSignedIn() && isValidId(chatId) && resource.data.userId == request.auth.uid;
    }
  }
}
